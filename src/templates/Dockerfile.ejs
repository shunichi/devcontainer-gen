FROM <%- baseImage %>

ARG TZ
ENV TZ="$TZ"

ENV DEBIAN_FRONTEND=noninteractive
<% if (needsNodeInstall && languages?.node) { -%>

# Install Node.js <%- languages.node.version %>
RUN curl -fsSL https://deb.nodesource.com/setup_<%- languages.node.version %>.x | bash -
<% } -%>

# Install <%- needsNodeInstall ? 'system packages' : 'basic development tools and iptables/ipset' %>
RUN apt-get update && apt-get install -y --no-install-recommends \
  less \
  git \
  procps \
  sudo \
  fzf \
  zsh \
  man-db \
  unzip \
  gnupg2 \
  gh \
  iptables \
  ipset \
  iproute2 \
  dnsutils \
  dnsmasq \
  aggregate \
  jq \
  nano \
  ripgrep \
  vim \
  tmux \
  openssh-server \
<% if (system_packages) { for (const pkg of system_packages) { -%>
  <%- pkg %> \
<% } } -%>
  && apt-get clean && rm -rf /var/lib/apt/lists/*

<% if (!userExists) { -%>
# Create <%- container.user %> user (UID 1000)
ARG USERNAME=<%- container.user %>
RUN groupadd --gid 1000 $USERNAME \
  && useradd --uid 1000 --gid 1000 -m -s /bin/zsh $USERNAME \
  && mkdir -p /usr/local/share/npm-global \
  && chown -R $USERNAME:$USERNAME /usr/local/share/npm-global /usr/local/share/zsh
<% } else { -%>
# Ensure default <%- container.user %> user has access to /usr/local/share
RUN mkdir -p /usr/local/share/npm-global && \
  chown -R <%- container.user %>:<%- container.user %> /usr/local/share

ARG USERNAME=<%- container.user %>
<% } -%>

# Persist command history
RUN SNIPPET="export PROMPT_COMMAND='history -a' && export HISTFILE=/commandhistory/.bash_history" \
  && mkdir /commandhistory \
  && touch /commandhistory/.bash_history \
  && chown -R $USERNAME /commandhistory

# Set `DEVCONTAINER` environment variable to help with orientation
ENV DEVCONTAINER=true

# Create workspace and config directories and set permissions
RUN mkdir -p /workspace /home/<%- container.user %>/.claude && \
  chown -R <%- container.user %>:<%- container.user %> /workspace /home/<%- container.user %>/.claude
<% if (languages?.ruby) { -%>

# Allow <%- container.user %> user to write to bundler directory
RUN chown -R $USERNAME:$USERNAME /usr/local/bundle
<% } -%>

WORKDIR /workspace

ARG GIT_DELTA_VERSION=<%- tools?.git_delta ?? '0.18.2' %>
RUN ARCH=$(dpkg --print-architecture) && \
  wget "https://github.com/dandavison/delta/releases/download/${GIT_DELTA_VERSION}/git-delta_${GIT_DELTA_VERSION}_${ARCH}.deb" && \
  sudo dpkg -i "git-delta_${GIT_DELTA_VERSION}_${ARCH}.deb" && \
  rm "git-delta_${GIT_DELTA_VERSION}_${ARCH}.deb"

# Set up non-root user
USER <%- container.user %>

# Install global packages
ENV NPM_CONFIG_PREFIX=/usr/local/share/npm-global
ENV PATH=$PATH:/usr/local/share/npm-global/bin:/home/<%- container.user %>/.local/bin

# Set the default shell to zsh rather than sh
ENV SHELL=/bin/zsh

# Set the default editor and visual
ENV EDITOR=<%- container.editor ?? 'code' %>
ENV VISUAL=<%- container.editor ?? 'code' %>

# Default powerline10k theme
ARG ZSH_IN_DOCKER_VERSION=<%- tools?.zsh_in_docker ?? '1.2.0' %>
RUN sh -c "$(wget -O- https://github.com/deluan/zsh-in-docker/releases/download/v${ZSH_IN_DOCKER_VERSION}/zsh-in-docker.sh)" -- \
  -p git \
  -p fzf \
  -a "source /usr/share/doc/fzf/examples/key-bindings.zsh" \
  -a "source /usr/share/doc/fzf/examples/completion.zsh" \
  -a "export PROMPT_COMMAND='history -a' && export HISTFILE=/commandhistory/.bash_history" \
  -x
<% if (languages?.node?.package_manager === 'pnpm') { -%>

ARG PNPM_VERSION=<%- languages.node.pnpm_version ?? 'latest' %>

# Install pnpm and zsh completion
RUN npm install -g pnpm@${PNPM_VERSION} \
  && mkdir -p /usr/local/share/zsh/site-functions \
  && pnpm completion zsh > /usr/local/share/zsh/site-functions/_pnpm
<% } -%>
<% if (tools?.firebase_tools) { -%>

# Install Firebase CLI
RUN npm install -g firebase-tools@<%- tools.firebase_tools %>
<% } -%>

# Install Claude Code
RUN curl -fsSL https://claude.ai/install.sh | bash
<% const homeDir = `/home/${container.user}`; -%>
<% const mountDirs = (mounts ?? []).map(m => m.target).filter(t => t.startsWith('/workspace/') || t.startsWith(homeDir + '/')); -%>
<% if (mountDirs.length > 0) { -%>

# Pre-create directories for named volume mounts (owned by <%- container.user %> user)
RUN mkdir -p \
<% mountDirs.forEach((dir, i) => { -%>
  <%- dir %><%= i < mountDirs.length - 1 ? ' \\' : '' %>
<% }) -%>
<% } -%>
<% if (dockerfile?.extra_run_commands) { for (const cmd of dockerfile.extra_run_commands) { -%>

<%- cmd %>
<% } } -%>

# Firewall mode: restrict (default) or observe (for domain discovery)
ARG FIREWALL_MODE=<%- container.firewall_mode ?? 'restrict' %>

# Copy and set up firewall script.
# Create dnsmasq log file owned by nobody at build time to avoid permission issues at runtime.
COPY init-firewall.sh test-firewall.sh /usr/local/bin/
USER root
RUN chmod +x /usr/local/bin/init-firewall.sh /usr/local/bin/test-firewall.sh && \
  echo "<%- container.user %> ALL=(root) NOPASSWD: /usr/local/bin/init-firewall.sh ${FIREWALL_MODE}, /usr/local/bin/test-firewall.sh, /usr/bin/mkdir -p /run/sshd, /usr/sbin/sshd" > /etc/sudoers.d/<%- container.user %>-firewall && \
  chmod 0440 /etc/sudoers.d/<%- container.user %>-firewall && \
  echo "${FIREWALL_MODE}" > /etc/firewall-mode && chmod 644 /etc/firewall-mode && \
  touch /var/log/dnsmasq.log && chown nobody:nogroup /var/log/dnsmasq.log
USER <%- container.user %>
