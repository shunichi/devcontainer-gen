services:
  app:
    build:
      context: .
      args:
        TZ: ${TZ:-<%- container.timezone %>}
        CLAUDE_CODE_VERSION: <%- tools?.claude_code ?? 'latest' %>
        GIT_DELTA_VERSION: "<%- tools?.git_delta ?? '0.18.2' %>"
        ZSH_IN_DOCKER_VERSION: "<%- tools?.zsh_in_docker ?? '1.2.0' %>"
<% if (languages?.node?.package_manager === 'pnpm' && languages.node.pnpm_version) { -%>
        PNPM_VERSION: "<%- languages.node.pnpm_version %>"
<% } -%>
        FIREWALL_MODE: <%- container.firewall_mode ?? 'restrict' %>  # observe に変更してリビルドでドメイン調査モード
    cap_add:
      - NET_ADMIN
      - NET_RAW
    ports:
      - "127.0.0.1:2222:22"
<% if (compose?.app_environment && Object.keys(compose.app_environment).length > 0) { -%>
    environment:
<% for (const [key, val] of Object.entries(compose.app_environment)) { -%>
      <%- key %>: "<%- val %>"
<% } -%>
<% } -%>
    command: sleep infinity
    volumes:
      - ..:/workspace:cached
<% if (serviceNames.length > 0) { -%>
    depends_on:
<% for (const name of serviceNames) { -%>
      - <%- name %>
<% } -%>
<% } -%>
<% if (services) { for (const [name, svc] of Object.entries(services)) { -%>

  <%- name %>:
    image: <%- svc.image %>
<% if (svc.environment && Object.keys(svc.environment).length > 0) { -%>
    environment:
<% for (const [key, val] of Object.entries(svc.environment)) { -%>
      <%- key %>: <%- val %>
<% } -%>
<% } -%>
<% if (svc.volumes && svc.volumes.length > 0) { -%>
    volumes:
<% for (const vol of svc.volumes) { -%>
      - <%- project.name %>-<%- vol %>
<% } -%>
<% } -%>
<% if (svc.ports && svc.ports.length > 0) { -%>
    ports:
<% for (const port of svc.ports) { -%>
      - "<%- port %>"
<% } -%>
<% } -%>
<% } } -%>
<% if (services) { -%>
<% const allVolumes = Object.entries(services).flatMap(([, svc]) => (svc.volumes ?? []).map(v => v.split(':')[0])); -%>
<% if (allVolumes.length > 0) { -%>

volumes:
<% for (const vol of allVolumes) { -%>
  <%- project.name %>-<%- vol %>:
    name: <%- project.name %>-<%- vol %>
<% } -%>
<% } -%>
<% } -%>
